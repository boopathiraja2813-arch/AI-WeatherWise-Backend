# Server Configuration
PORT=5000

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/weatherwise

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_12345!

# OpenWeatherMap API Key (Free tier from https://openweathermap.org/api)
# Note: If left unset or with placeholder, the server will use realistic deterministic mock weather data
WEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Google Gemini API Key (From https://aistudio.google.com/)
# Note: If left unset or with placeholder, the server will use realistic natural-language fallback recommendations
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: Gemini Model Name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
